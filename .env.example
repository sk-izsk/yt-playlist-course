# Copy to .env.local and fill in. .env.local is gitignored and never uploaded (see .vercelignore).

# Neon Postgres, pooled URL (host contains -pooler). sslmode=verify-full keeps pg quiet.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Signs login tokens. Generate: openssl rand -base64 48
JWT_SECRET=

# No login credentials here: create your login with `make user NAME=you` (hidden password prompt, only a hash is stored).

# Optional, Mac only: local Postgres mirror (e.g. Postgres.app) refreshed by `make db-backup` / `make backup-install`.
# Enables the read-only "Local backup" view in Settings. Create the empty DB first: createdb tubewise_mirror
# LOCAL_DATABASE_URL=postgresql://localhost:5432/tubewise_mirror

# Optional: turns on the "Ask" tab (AI tutor, claude-haiku-5-5). Without it the app makes no paid calls.
# ANTHROPIC_API_KEY=
# Daily caps (defaults): owner 200 questions, all visitors together 30.
# TUTOR_DAILY_CAP_OWNER=200
# TUTOR_DAILY_CAP_PUBLIC=30

# Vercel only: protects /api/cron/check-updates. Generate: openssl rand -hex 24
# CRON_SECRET=
