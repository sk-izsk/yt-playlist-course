# What NOT to commit. Each section says why it's safe to ignore.

# ---------------------------------------------------------------------------
# Dependencies — recreated by `bun install` (bun.lock IS committed)
# ---------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# Lockfiles from other package managers — this project uses bun only
package-lock.json
yarn.lock
pnpm-lock.yaml

# ---------------------------------------------------------------------------
# Build output & caches — recreated by `make dev` / `make build`
# ---------------------------------------------------------------------------
/.next/
/out/
/build
/coverage
*.tsbuildinfo
# Generated by Next on every dev/build run
next-env.d.ts

# ---------------------------------------------------------------------------
# Local data — your personal library, never commit it
# The live DB is ~/.courseit/app.db (outside the repo); these catch strays.
# ---------------------------------------------------------------------------
/data
*.db
*.db-wal
*.db-shm
*.db.moved

# ---------------------------------------------------------------------------
# Secrets & env — none are needed today, but keep them out if added later
# ---------------------------------------------------------------------------
.env*
!.env.example
*.pem

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---------------------------------------------------------------------------
# AI-tool caches & per-machine settings (shared agent docs ARE committed:
# AGENTS.md, CLAUDE.md, .claude/launch.json)
# ---------------------------------------------------------------------------
.code-review-graph/
.omc/
.claude/*.local.json
.claude/settings.local.json

# Deploy tooling (not used — app is local-only)
.vercel
