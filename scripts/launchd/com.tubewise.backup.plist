<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: `make backup-install` fills in __REPO__ and __HOME__ and loads it. Runs scripts/backup.sh every 15 min. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tubewise.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/backup.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/Applications/Postgres.app/Contents/Versions/latest/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.courseit/backups/backup.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.courseit/backups/backup.log</string>
</dict>
</plist>
